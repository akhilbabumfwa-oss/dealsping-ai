{
  "name": "dealsping-ai",
  "version": "1.0.0",
  "description": "DealsPing AI Deal Discovery System — Cloudflare Workers + D1",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create dealsping-ai-db",
    "d1:schema": "wrangler d1 execute dealsping-ai-db --file=schema.sql",
    "d1:schema:remote": "wrangler d1 execute dealsping-ai-db --file=schema.sql --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
